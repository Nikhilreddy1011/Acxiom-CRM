@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Create Customer";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4 p-md-5">
            <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
                <div>
                    <h4 class="fw-bold mb-1">Create Customer Account</h4>
                    <p class="text-muted small mb-0">Add a new corporate or individual client record.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerName" class="form-label fw-semibold small">Customer Name *</label>
                        <input asp-for="CustomerName" class="form-control" placeholder="e.g. Acme Corporation" required />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label fw-semibold small">Company Name</label>
                        <input asp-for="CompanyName" class="form-control" placeholder="e.g. Acme Corp" />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small">Email Address *</label>
                        <input asp-for="Email" class="form-control" placeholder="client@company.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold small">Phone Number *</label>
                        <input asp-for="Phone" class="form-control" placeholder="+1-555-0100" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-semibold small">Street Address</label>
                        <input asp-for="Address" class="form-control" placeholder="123 Business Boulevard" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="City" class="form-label fw-semibold small">City</label>
                        <input asp-for="City" class="form-control" placeholder="Chicago" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="State" class="form-label fw-semibold small">State / Province</label>
                        <input asp-for="State" class="form-control" placeholder="IL" />
                    </div>

                    @if (!User.IsInRole("SalesExecutive"))
                    {
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Assigned Sales Executive</label>
                            <select asp-for="AssignedTo" asp-items="ViewBag.Users" class="form-select">
                                <option value="">-- Select Sales Executive --</option>
                            </select>
                        </div>
                    }

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold small">Account Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>Save Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>

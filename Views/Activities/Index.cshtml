@model IEnumerable<AcxiomCRM.Models.Activity>
@{
    ViewData["Title"] = "CRM Activity Timeline";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">Sales Activities & Client Touchpoints</h4>
        <p class="text-muted small mb-0">Audit and track customer touchpoints, calls, meetings, emails, and tasks.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Log New Activity</a>
</div>

<!-- Filters -->
<div class="card p-3 mb-4">
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index")" class="btn btn-sm @(string.IsNullOrEmpty(ViewBag.CurrentType) ? "btn-primary" : "btn-outline-secondary")">All Activities</a>
        <a href="@Url.Action("Index", new { type = "Call" })" class="btn btn-sm @(ViewBag.CurrentType == "Call" ? "btn-primary" : "btn-outline-secondary")"><i class="bi bi-telephone me-1"></i>Calls</a>
        <a href="@Url.Action("Index", new { type = "Meeting" })" class="btn btn-sm @(ViewBag.CurrentType == "Meeting" ? "btn-primary" : "btn-outline-secondary")"><i class="bi bi-people me-1"></i>Meetings</a>
        <a href="@Url.Action("Index", new { type = "Email" })" class="btn btn-sm @(ViewBag.CurrentType == "Email" ? "btn-primary" : "btn-outline-secondary")"><i class="bi bi-envelope me-1"></i>Emails</a>
        <a href="@Url.Action("Index", new { type = "Task" })" class="btn btn-sm @(ViewBag.CurrentType == "Task" ? "btn-primary" : "btn-outline-secondary")"><i class="bi bi-check2-square me-1"></i>Tasks</a>
    </div>
</div>

<!-- Activity Stream Card -->
<div class="card p-4">
    @if (Model.Any())
    {
        <div class="list-group list-group-flush">
            @foreach (var a in Model)
            {
                <div class="list-group-item px-0 py-3 d-flex align-items-start justify-content-between gap-3 border-bottom">
                    <div class="d-flex align-items-start gap-3">
                        <div class="p-2 rounded-circle bg-light border text-primary">
                            @if (a.ActivityType == "Call") { <i class="bi bi-telephone-fill"></i> }
                            else if (a.ActivityType == "Meeting") { <i class="bi bi-people-fill"></i> }
                            else if (a.ActivityType == "Email") { <i class="bi bi-envelope-fill"></i> }
                            else { <i class="bi bi-list-check"></i> }
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold text-dark">@a.Subject</span>
                                <span class="badge bg-light text-secondary border">@a.ActivityType</span>
                            </div>
                            <div class="text-muted small mt-1">@a.Description</div>
                            <div class="small mt-2 text-secondary">
                                Associated with: 
                                <strong>@(a.Customer?.CustomerName ?? a.Lead?.LeadName ?? a.Opportunity?.OpportunityName ?? "General CRM")</strong> • 
                                Recorded by: <strong>@(a.AssignedUser?.FullName ?? "System")</strong>
                            </div>
                        </div>
                    </div>
                    <div class="text-end text-nowrap">
                        <span class="badge bg-light text-dark border">@a.ActivityDate.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-list-task fs-1 d-block mb-2"></i>
            No CRM activities recorded.
        </div>
    }
</div>

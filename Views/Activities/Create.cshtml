@model AcxiomCRM.Models.Activity
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4 p-md-5">
            <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
                <div>
                    <h4 class="fw-bold mb-1">Log CRM Activity</h4>
                    <p class="text-muted small mb-0">Record a completed touchpoint, phone call, meeting, or task.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ActivityType" class="form-label fw-semibold small">Activity Type</label>
                        <select asp-for="ActivityType" class="form-select">
                            <option value="Call">Phone Call</option>
                            <option value="Meeting">Meeting</option>
                            <option value="Email">Email Sent / Received</option>
                            <option value="Task">Task Completed</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ActivityDate" class="form-label fw-semibold small">Activity Date & Time</label>
                        <input asp-for="ActivityDate" type="datetime-local" class="form-control" required />
                    </div>

                    <div class="col-12">
                        <label asp-for="Subject" class="form-label fw-semibold small">Subject / Headline *</label>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. Discussed Q1 pricing and licensing tier" required />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Link Customer</label>
                        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                            <option value="">-- None --</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Link Lead</label>
                        <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
                            <option value="">-- None --</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Link Opportunity</label>
                        <select asp-for="OpportunityId" asp-items="ViewBag.Opportunities" class="form-select">
                            <option value="">-- None --</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold small">Detailed Summary / Discussion Notes</label>
                        <textarea asp-for="Description" rows="4" class="form-control" placeholder="Detailed summary of points discussed, customer objections raised, agreed action items..."></textarea>
                    </div>

                    @if (!User.IsInRole("SalesExecutive"))
                    {
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Assigned Staff</label>
                            <select asp-for="AssignedTo" asp-items="ViewBag.Users" class="form-select">
                                <option value="">-- Select Staff --</option>
                            </select>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>Save Activity</button>
                </div>
            </form>
        </div>
    </div>
</div>

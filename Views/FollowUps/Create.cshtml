@model AcxiomCRM.Models.FollowUp
@{
    ViewData["Title"] = "Schedule Follow-up";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4 p-md-5">
            <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
                <div>
                    <h4 class="fw-bold mb-1">Schedule Follow-up</h4>
                    <p class="text-muted small mb-0">Book a future customer or lead interaction.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Linked Customer</label>
                        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                            <option value="">-- Optional: Link Customer --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Linked Lead</label>
                        <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
                            <option value="">-- Optional: Link Lead --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FollowUpType" class="form-label fw-semibold small">Follow-up Type</label>
                        <select asp-for="FollowUpType" class="form-select">
                            <option value="Call">Phone Call</option>
                            <option value="Meeting">In-Person / Online Meeting</option>
                            <option value="Email">Email Follow-up</option>
                            <option value="Demo">Product Demonstration</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FollowUpDate" class="form-label fw-semibold small">Scheduled Date & Time * (Cannot be in past)</label>
                        <input asp-for="FollowUpDate" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Subject" class="form-label fw-semibold small">Subject / Purpose *</label>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. Discuss revised proposal terms" required />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Remarks" class="form-label fw-semibold small">Notes / Agenda Remarks</label>
                        <textarea asp-for="Remarks" rows="3" class="form-control" placeholder="Key topics to discuss, requested deliverables, participant list..."></textarea>
                    </div>

                    @if (!User.IsInRole("SalesExecutive"))
                    {
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Assigned Sales Executive</label>
                            <select asp-for="AssignedTo" asp-items="ViewBag.Users" class="form-select">
                                <option value="">-- Assign Sales Executive --</option>
                            </select>
                        </div>
                    }

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold small">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Planned">Planned</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-calendar-check me-1"></i>Save Follow-up</button>
                </div>
            </form>
        </div>
    </div>
</div>

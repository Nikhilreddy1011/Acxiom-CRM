@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Create Opportunity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4 p-md-5">
            <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
                <div>
                    <h4 class="fw-bold mb-1">Create Opportunity</h4>
                    <p class="text-muted small mb-0">Record a qualified deal in the sales revenue pipeline.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="OpportunityName" class="form-label fw-semibold small">Opportunity / Deal Name *</label>
                        <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Enterprise Cloud Subscription - Phase 1" required />
                        <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Linked Customer Account</label>
                        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                            <option value="">-- Optional: Link Customer --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Linked Lead</label>
                        <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
                            <option value="">-- Optional: Link Lead --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Amount" class="form-label fw-semibold small">Deal Value ($) * (Must be > 0)</label>
                        <input asp-for="Amount" type="number" step="100" class="form-control" placeholder="50000" required />
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Probability" class="form-label fw-semibold small">Probability % (0 - 100)</label>
                        <input asp-for="Probability" type="number" min="0" max="100" class="form-control" value="25" required />
                        <span asp-validation-for="Probability" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Stage" class="form-label fw-semibold small">Pipeline Stage</label>
                        <select asp-for="Stage" class="form-select">
                            <option value="Qualification">Qualification</option>
                            <option value="Proposal">Proposal</option>
                            <option value="Negotiation">Negotiation</option>
                            <option value="Won">Won</option>
                            <option value="Lost">Lost</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExpectedCloseDate" class="form-label fw-semibold small">Target Close Date * (Cannot be past)</label>
                        <input asp-for="ExpectedCloseDate" type="date" class="form-control" required />
                        <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                    </div>

                    @if (!User.IsInRole("SalesExecutive"))
                    {
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Deal Owner</label>
                            <select asp-for="AssignedTo" asp-items="ViewBag.Users" class="form-select">
                                <option value="">-- Assign Sales Executive --</option>
                            </select>
                        </div>
                    }

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold small">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Open">Open</option>
                            <option value="Won">Won</option>
                            <option value="Lost">Lost</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>Save Opportunity</button>
                </div>
            </form>
        </div>
    </div>
</div>

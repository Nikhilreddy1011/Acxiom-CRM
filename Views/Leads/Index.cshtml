@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Management";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">Sales Leads Pipeline</h4>
        <p class="text-muted small mb-0">Total records: @ViewBag.TotalCount</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Add New Lead</a>
</div>

<!-- Search & Filters -->
<div class="card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search lead name, company, email, phone..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="New" selected="@(ViewBag.Status == "New")">New</option>
                <option value="Contacted" selected="@(ViewBag.Status == "Contacted")">Contacted</option>
                <option value="Qualified" selected="@(ViewBag.Status == "Qualified")">Qualified</option>
                <option value="Unqualified" selected="@(ViewBag.Status == "Unqualified")">Unqualified</option>
                <option value="Converted" selected="@(ViewBag.Status == "Converted")">Converted</option>
                <option value="Lost" selected="@(ViewBag.Status == "Lost")">Lost</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="priority" class="form-select">
                <option value="">All Priorities</option>
                <option value="High" selected="@(ViewBag.Priority == "High")">High</option>
                <option value="Medium" selected="@(ViewBag.Priority == "Medium")">Medium</option>
                <option value="Low" selected="@(ViewBag.Priority == "Low")">Low</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-filter me-1"></i>Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<!-- Leads Data Table -->
<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Lead Name</th>
                    <th>Company</th>
                    <th>Contact</th>
                    <th>Source</th>
                    <th>Expected Value</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@l.LeadCode</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@l.LeadId" class="fw-semibold text-primary text-decoration-none">
                                    @l.LeadName
                                </a>
                            </td>
                            <td>@(l.CompanyName ?? "-")</td>
                            <td>
                                <div><i class="bi bi-envelope text-muted me-1"></i>@l.Email</div>
                                <div class="small text-muted"><i class="bi bi-telephone text-muted me-1"></i>@l.Phone</div>
                            </td>
                            <td><span class="badge bg-light text-secondary border">@l.Source</span></td>
                            <td class="fw-bold text-dark">$@l.ExpectedValue.ToString("N0")</td>
                            <td>
                                @if (l.Priority == "High") { <span class="badge bg-danger">High</span> }
                                else if (l.Priority == "Medium") { <span class="badge bg-warning text-dark">Medium</span> }
                                else { <span class="badge bg-secondary">Low</span> }
                            </td>
                            <td>
                                @if (l.Status == "Converted") { <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Converted</span> }
                                else if (l.Status == "Qualified") { <span class="badge bg-primary">Qualified</span> }
                                else if (l.Status == "Contacted") { <span class="badge bg-info text-dark">Contacted</span> }
                                else if (l.Status == "New") { <span class="badge bg-secondary">New</span> }
                                else { <span class="badge bg-dark">@l.Status</span> }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (l.Status != "Converted")
                                    {
                                        <a asp-action="Convert" asp-route-id="@l.LeadId" class="btn btn-outline-success" title="Convert to Customer & Opportunity">
                                            <i class="bi bi-arrow-repeat me-1"></i>Convert
                                        </a>
                                    }
                                    <a asp-action="Details" asp-route-id="@l.LeadId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-person-lines-fill fs-1 d-block mb-2"></i>
                            No leads found matching the filter criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex align-items-center justify-content-between p-3 border-top">
            <div class="small text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, search = ViewBag.Search, status = ViewBag.Status, priority = ViewBag.Priority })">Previous</a>
                    </li>
                    @for (int p = 1; p <= ViewBag.TotalPages; p++)
                    {
                        <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = p, search = ViewBag.Search, status = ViewBag.Status, priority = ViewBag.Priority })">@p</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, search = ViewBag.Search, status = ViewBag.Status, priority = ViewBag.Priority })">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

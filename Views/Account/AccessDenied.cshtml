@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card p-5 mx-auto shadow-sm" style="max-width: 600px; border-radius: 16px;">
        <i class="bi bi-shield-slash-fill text-danger" style="font-size: 4rem;"></i>
        <h2 class="fw-bold mt-3 text-dark">Access Denied</h2>
        <p class="text-muted mt-2">
            You do not have the required permissions or role privileges to view or perform operations on this resource.
        </p>
        <div class="mt-4">
            <a href="/" class="btn btn-primary"><i class="bi bi-house-door me-2"></i>Return to Dashboard</a>
        </div>
    </div>
</div>

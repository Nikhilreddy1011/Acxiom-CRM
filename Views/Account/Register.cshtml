@model AcxiomCRM.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="card shadow-sm p-4 p-md-5" style="max-width: 500px; width: 100%; border-radius: 16px;">
        <div class="text-center mb-4">
            <i class="bi bi-shield-check text-primary fs-1"></i>
            <h3 class="fw-bold text-dark mt-2 mb-1">Create an Account</h3>
            <p class="text-muted small">Register for AcxiomCRM sales workspace</p>
        </div>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-medium small">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="John Doe" required />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-medium small">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="john@example.com" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-medium small">Password (Min 6 chars, 1 uppercase, 1 digit)</label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-medium small">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Complete Registration</button>

            <div class="text-center mt-4">
                <span class="text-muted small">Already have an account? </span>
                <a asp-action="Login" class="small fw-semibold text-decoration-none">Sign in here</a>
            </div>
        </form>
    </div>
</div>

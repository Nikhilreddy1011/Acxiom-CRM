@model AcxiomCRM.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="card shadow-sm p-4 p-md-5" style="max-width: 520px; width: 100%; border-radius: 16px;">
        <div class="text-center mb-4">
            <i class="bi bi-shield-check text-primary fs-1"></i>
            <h3 class="fw-bold text-dark mt-2 mb-1">Create an Account</h3>
            <p class="text-muted small">Register for AcxiomCRM sales workspace</p>
        </div>

        <form asp-action="Register" method="post" id="registerForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Role" value="SalesExecutive" />

            <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-medium small">Full Name *</label>
                <input asp-for="FullName" class="form-control" placeholder="John Doe" required autofocus />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-medium small">Email Address *</label>
                <input asp-for="Email" class="form-control" placeholder="john@example.com" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-medium small">Password *</label>
                <div class="input-group">
                    <input asp-for="Password" id="passwordInput" class="form-control" placeholder="••••••••" required />
                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                        <i class="bi bi-eye" id="togglePasswordIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>

                <!-- Real-time Password Validation Checklist -->
                <div class="p-3 mt-2 rounded-3 bg-light border" id="passwordCriteriaBox">
                    <div class="fw-semibold small text-dark mb-2">Password Requirements:</div>
                    <ul class="list-unstyled mb-0 small" style="line-height: 1.8;">
                        <li id="req-len" class="text-danger">
                            <i class="bi bi-x-circle me-1" id="icon-len"></i>At least 6 characters
                        </li>
                        <li id="req-upper" class="text-danger">
                            <i class="bi bi-x-circle me-1" id="icon-upper"></i>At least one uppercase letter (A-Z)
                        </li>
                        <li id="req-lower" class="text-danger">
                            <i class="bi bi-x-circle me-1" id="icon-lower"></i>At least one lowercase letter (a-z)
                        </li>
                        <li id="req-num" class="text-danger">
                            <i class="bi bi-x-circle me-1" id="icon-num"></i>At least one number (0-9)
                        </li>
                    </ul>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-medium small">Confirm Password *</label>
                <input asp-for="ConfirmPassword" id="confirmPasswordInput" class="form-control" placeholder="••••••••" required />
                <div id="matchFeedback" class="small mt-1 text-danger" style="display: none;">
                    <i class="bi bi-x-circle me-1" id="matchIcon"></i><span id="matchText">Passwords do not match</span>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" id="submitBtn" class="btn btn-primary w-100 py-2 fw-semibold" disabled>
                <i class="bi bi-person-check-fill me-1"></i>Complete Registration
            </button>

            <div class="text-center mt-4">
                <span class="text-muted small">Already have an account? </span>
                <a asp-action="Login" class="small fw-semibold text-decoration-none">Sign in here</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const pwd = document.getElementById("passwordInput");
            const confirmPwd = document.getElementById("confirmPasswordInput");
            const submitBtn = document.getElementById("submitBtn");
            const togglePwd = document.getElementById("togglePassword");
            const toggleIcon = document.getElementById("togglePasswordIcon");

            const reqLen = document.getElementById("req-len");
            const reqUpper = document.getElementById("req-upper");
            const reqLower = document.getElementById("req-lower");
            const reqNum = document.getElementById("req-num");

            const iconLen = document.getElementById("icon-len");
            const iconUpper = document.getElementById("icon-upper");
            const iconLower = document.getElementById("icon-lower");
            const iconNum = document.getElementById("icon-num");

            const matchFeedback = document.getElementById("matchFeedback");
            const matchIcon = document.getElementById("matchIcon");
            const matchText = document.getElementById("matchText");

            // Toggle show/hide password
            togglePwd.addEventListener("click", function () {
                const isPassword = pwd.getAttribute("type") === "password";
                pwd.setAttribute("type", isPassword ? "text" : "password");
                confirmPwd.setAttribute("type", isPassword ? "text" : "password");
                toggleIcon.className = isPassword ? "bi bi-eye-slash" : "bi bi-eye";
            });

            function updateRequirement(element, icon, isValid) {
                if (isValid) {
                    element.className = "text-success fw-medium";
                    icon.className = "bi bi-check-circle-fill text-success me-1";
                } else {
                    element.className = "text-danger";
                    icon.className = "bi bi-x-circle text-danger me-1";
                }
            }

            function validateAll() {
                const val = pwd.value;
                const confirmVal = confirmPwd.value;

                const hasLen = val.length >= 6;
                const hasUpper = /[A-Z]/.test(val);
                const hasLower = /[a-z]/.test(val);
                const hasNum = /[0-9]/.test(val);

                updateRequirement(reqLen, iconLen, hasLen);
                updateRequirement(reqUpper, iconUpper, hasUpper);
                updateRequirement(reqLower, iconLower, hasLower);
                updateRequirement(reqNum, iconNum, hasNum);

                const passwordValid = hasLen && hasUpper && hasLower && hasNum;

                // Match check
                let matchValid = false;
                if (confirmVal.length > 0) {
                    matchFeedback.style.display = "block";
                    if (val === confirmVal) {
                        matchValid = true;
                        matchFeedback.className = "small mt-1 text-success fw-medium";
                        matchIcon.className = "bi bi-check-circle-fill text-success me-1";
                        matchText.innerText = "Passwords match";
                    } else {
                        matchFeedback.className = "small mt-1 text-danger";
                        matchIcon.className = "bi bi-x-circle text-danger me-1";
                        matchText.innerText = "Passwords do not match";
                    }
                } else {
                    matchFeedback.style.display = "none";
                }

                if (passwordValid && matchValid) {
                    submitBtn.removeAttribute("disabled");
                } else {
                    submitBtn.setAttribute("disabled", "true");
                }
            }

            pwd.addEventListener("input", validateAll);
            confirmPwd.addEventListener("input", validateAll);
        });
    </script>
}

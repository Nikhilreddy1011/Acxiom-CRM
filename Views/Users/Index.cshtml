@model IEnumerable<AcxiomCRM.ViewModels.UserListItemViewModel>
@{
    ViewData["Title"] = "User & Role Administration";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">User & Role Administration</h4>
        <p class="text-muted small mb-0">Manage system users, access credentials, role assignments, and security lockout policies.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Create New User</a>
</div>

<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email Address</th>
                    <th>Assigned Role</th>
                    <th>Account Status</th>
                    <th>Lockout State</th>
                    <th>Registered Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold text-dark">@u.FullName</td>
                        <td>@u.Email</td>
                        <td>
                            @if (u.Role == "Admin") { <span class="badge bg-danger">Admin</span> }
                            else if (u.Role == "Manager") { <span class="badge bg-warning text-dark">Manager</span> }
                            else { <span class="badge bg-primary">Sales Executive</span> }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">Deactivated</span>
                            }
                        </td>
                        <td>
                            @if (u.IsLockedOut)
                            {
                                <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Locked Out</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">Normal</span>
                            }
                        </td>
                        <td class="text-muted small">@u.CreatedDate.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-primary" title="Edit User">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Toggle active status for this user?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(u.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi @(u.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

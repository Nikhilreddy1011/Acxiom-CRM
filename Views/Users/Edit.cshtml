@model AcxiomCRM.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = $"Edit User - {Model.FullName}";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card p-4 p-md-5">
            <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
                <div>
                    <h4 class="fw-bold mb-1">Edit User Profile: @Model.FullName</h4>
                    <p class="text-muted small mb-0">Modify user role and account status.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold small">Full Name *</label>
                    <input asp-for="FullName" class="form-control" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small">Email Address *</label>
                    <input asp-for="Email" class="form-control" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label fw-semibold small">Role Assignment</label>
                    <select asp-for="Role" asp-items="ViewBag.Roles" class="form-select"></select>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label small fw-medium">Active Account</label>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="UnlockAccount" class="form-check-input" />
                    <label asp-for="UnlockAccount" class="form-check-label small fw-medium text-danger">Reset / Unlock Account Lockout</label>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i>Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
